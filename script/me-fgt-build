#!/usr/bin/env bash
# vim: autoindent cindent et ts=4 sw=4 sts=4:
#
# Run the fortidev 'prep.sh' for the current source tree's major version,
# or run './Configure' for a KVM build.
#
#   me fgt build          # run fortidev prep.sh (major-aware)
#   me fgt build kvm      # run prep.sh, then ./Configure for KVM
#                         #   (was `me tool fgt-build`)
#                         #   fortiproxy.git -> ./Configure -m FPX_KVM -d y
#                         #   fortios.git    -> ./Configure -m FGT_VM64_KVM -d y -c
#
# The major version is read from the repo's '.version' (CONFIG_MAJOR_NUM).

# me API — scan all args for the me-API tokens, since a positional action
# (e.g. 'kvm') may precede them: `me fgt build kvm -h`.
for _arg in "$@"; do
    case "$_arg" in
        --summary) echo "Run fortidev prep.sh (build env setup)"; exit 0 ;;
        --complete|__complete)
            printf '%s\n' --help -h -v -d -n --verbose --dryrun --debug --version kvm
            exit 0 ;;
        -h|--help)
            echo "Usage: me fgt build [kvm] [options]"
            echo "  Run the fortidev 'prep.sh' matching this tree's major version:"
            echo "    major >= 8  -> fortidev7 (~/.cache/fortinet/fortidev/fortidev-7.0.0)"
            echo "    otherwise   -> fortidev6 (~/.cache/fortinet/fortidev/fortidev-6.1.0)"
            echo ""
            echo "  'kvm' action: run ./Configure for the KVM platform"
            echo "    fortiproxy.git -> ./Configure -m FPX_KVM -d y"
            echo "    fortios.git    -> ./Configure -m FGT_VM64_KVM -d y -c"
            echo ""
            echo "  -v, -vvv, --verbose   Print all cmds if v>=3"
            echo "  -n, --dryrun          Dryrun mode"
            echo "  -d, --debug           Debug mode"
            echo "  -h, --help            Show this help"
            echo "  --version             Show version"
            echo ""
            echo "Script: ${BASH_SOURCE[0]}"
            exit 0 ;;
    esac
done

# Get the script's directory, resolving symlinks
var_ScriptDir="$( cd "$( dirname "$(readlink -f "${BASH_SOURCE[0]}")" )" &> /dev/null && pwd )"
var_ScriptName=$(basename "$0")
var_ScriptName="${var_ScriptName%.*}"
var_WorkDir=$(pwd)
SECONDS=0

colorRed='\e[31m'
colorGreen='\e[32m'
colorYellow='\e[33m'
colorReset='\e[0m'

FORTIDEV6_DIR="$HOME/.cache/fortinet/fortidev/fortidev-6.1.0"
FORTIDEV7_DIR="$HOME/.cache/fortinet/fortidev/fortidev-7.0.0"

# KVM Configure flags per remote repo
KVM_FPX_ARGS=(-m FPX_KVM -d y)
KVM_FOS_ARGS=(-m FGT_VM64_KVM -d y -c)

_Usage=$(cat <<-END
    Usage: run fortidev prep.sh or ./Configure for the current tree
      script [kvm] [options]

    Options:
      -v, -vvv, --verbose   Print all cmds if v<count> >= 3
      -n, --dryrun          Dump variables if prefix-as 'var_'
      -d, --debug
      -h, --help            Usage
      --version             Version

    Actions:
      (none)    Run fortidev prep.sh (major-aware)
      kvm       Run prep.sh, then ./Configure for KVM:
                  fortiproxy.git -> ./Configure -m FPX_KVM -d y
                  fortios.git    -> ./Configure -m FGT_VM64_KVM -d y -c

    Sample:
      me fgt build          # major>=8 -> fortidev7, else fortidev6
      me fgt build kvm      # prep.sh + ./Configure for KVM (repo-aware)
      me fgt build -n       # dryrun: show which prep.sh would run

END
)

parse_define() {
  setup   REST help:usage -- "Usage: $var_ScriptName [kvm] [options] ..." ''

  msg -- 'Options:'
  flag  var_VERBOSE    -v --verbose  counter:true init:=0    -- "e.g. -vvv is verbose level 3"
  flag  var_DRYRUN     -n --dryrun                           -- "Dryrun mode"
  flag  var_DEBUG      -d --debug                            -- "Debug mode and list all local variable"

  disp  VERSION        --version
  disp  :usage         -h --help   -- "$_Usage"
}


# Usage: varNum1=$( int var1 )
int ()
{
    printf '%d' $(expr ${1:-} : '[^0-9]*\([0-9]*\)' 2>/dev/null) || :
}


# Read CONFIG_MAJOR_NUM from .version; empty if not found.
get_major_version () {
    local ver_file="$1"
    if [[ ! -f "$ver_file" ]]; then
        echo ""
        return 1
    fi
    awk -F= '/^CONFIG_MAJOR_NUM=/ { gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; exit }' "$ver_file"
}


# Resolve the git toplevel; fall back to cwd.
resolve_git_top () {
    local git_top
    git_top=$(git rev-parse --show-toplevel 2>/dev/null)
    if [[ $? -ne 0 ]]; then
        git_top="$var_WorkDir"
    fi
    echo "$git_top"
}


# Detect remote repo type from origin URL.
# Echoes "fortiproxy" or "fortios"; dies on unknown.
detect_repo_type () {
    local origin_url
    origin_url=$(git remote get-url origin 2>/dev/null || true)
    if [[ -z "$origin_url" ]]; then
        die "Cannot detect remote: no 'origin' remote in this repo."
    fi
    if [[ "$origin_url" == *fortiproxy* ]]; then
        echo "fortiproxy"
    elif [[ "$origin_url" == *fortios* || "$origin_url" == *fos/* ]]; then
        echo "fortios"
    else
        die "Cannot detect repo type from origin URL: $origin_url"
    fi
}


do_args () {
    if [[ -n "$var_DRYRUN" ]]; then
        ( set -o posix ; set ) | grep -e '^var_'
        exit 1
    fi

    if [[ "$var_VERBOSE" -ge 3 ]]; then
        set -x                              ### Print each command before eval
    fi

    if [[ "$var_VERBOSE" -ge 4 ]]; then
        set -v                              ### Print each line of the script before eval
    fi
}


main () {
    do_args
    do_task "$@"
    cleanup
}


do_task () {
    local git_top
    git_top=$(resolve_git_top)
    cd "$git_top" || die "Cannot cd to git toplevel: $git_top"

    local sub_action="${1:-}"

    if [[ "$sub_action" == "kvm" ]]; then
        do_kvm "$git_top"
        return
    fi

    # Default: fortidev prep.sh
    do_prepsh "$git_top"
}


# Resolve the fortidev dir for the current tree's major version.
# Echoes the fortidev dir path; dies on missing .version.
resolve_fortidev_dir () {
    local git_top="$1"

    local ver_file="$git_top/.version"
    local major
    major=$(get_major_version "$ver_file")
    if [[ -z "$major" ]]; then
        die "Cannot read CONFIG_MAJOR_NUM from '$ver_file'. Run 'Configure' first."
    fi

    local fortidev_dir
    if [[ "$major" -ge 8 ]]; then
        fortidev_dir="$FORTIDEV7_DIR"
        echo -e "${colorGreen} major=$major >= 8 -> fortidev7: $fortidev_dir ${colorReset}" >&2
    else
        fortidev_dir="$FORTIDEV6_DIR"
        echo -e "${colorGreen} major=$major < 8 -> fortidev6: $fortidev_dir ${colorReset}" >&2
    fi

    echo "$fortidev_dir"
}


# Run prep.sh in the given fortidev dir (sudo for the /fortidev symlink).
# If /fortidev exists and is a symlink, remove it first; if it's a real
# directory, warn and exit to avoid clobbering a real install.
run_prepsh () {
    local fortidev_dir="$1"

    if [[ ! -d "$fortidev_dir" ]]; then
        echo -e "${colorRed} fortidev dir not found at '$fortidev_dir' ${colorReset}" >&2
        echo -e "${colorYellow} You can also manually download them from GitLab https://gitlab-van.corp.fortinet.com/fos/fortidev-image/-/packages ${colorReset}" >&2
        die "Is fortidev installed there?"
    fi

    if [[ -e /fortidev || -L /fortidev ]]; then
        if [[ -L /fortidev ]]; then
            echo -e "${colorYellow} /fortidev is a symlink, removing it first ${colorReset}"
            sudo rm -f /fortidev
        else
            die "/fortidev is a real directory, not a symlink. Refusing to overwrite. Remove it manually if needed."
        fi
    fi

    echo -e "${colorGreen} Running: cd '$fortidev_dir' && sudo ./prep.sh -u phos.corp.fortinet.com ${colorReset}"
    local _cwd_save="$PWD"
    local rc=0
    cd "$fortidev_dir" || die "Cannot cd to '$fortidev_dir'"
    sudo ./prep.sh -u phos.corp.fortinet.com
    rc=$?
    cd "$_cwd_save" 2>/dev/null || true
    if [[ $rc -ne 0 ]]; then
        die "prep.sh failed (rc=$rc)"
    fi
}


# Run fortidev prep.sh (major-aware)
do_prepsh () {
    local git_top="$1"

    local fortidev_dir
    fortidev_dir=$(resolve_fortidev_dir "$git_top") || exit $?

    run_prepsh "$fortidev_dir"
    echo -e "${colorGreen} Done: fortidev prep.sh ${colorReset}"
}


# Run ./Configure for KVM platform (repo-aware).
# Ensures fortidev prep.sh runs first (same major-aware check as 'me fgt build').
do_kvm () {
    local git_top="$1"
    local configure="$git_top/Configure"

    if [[ ! -x "$configure" ]]; then
        die "Configure not found or not executable at '$configure'."
    fi

    # 1. Fortidev env setup (same major-aware logic as the default action)
    local fortidev_dir
    fortidev_dir=$(resolve_fortidev_dir "$git_top") || exit $?
    run_prepsh "$fortidev_dir"

    # 2. Detect repo type and pick Configure args
    local repo_type
    repo_type=$(detect_repo_type)

    local -a cfg_args
    case "$repo_type" in
        fortiproxy)
            cfg_args=("${KVM_FPX_ARGS[@]}")
            echo -e "${colorGreen} fortiproxy.git -> ./Configure ${cfg_args[*]} ${colorReset}"
            ;;
        fortios)
            cfg_args=("${KVM_FOS_ARGS[@]}")
            echo -e "${colorGreen} fortios.git -> ./Configure ${cfg_args[*]} ${colorReset}"
            ;;
        *)
            die "Unknown repo type '$repo_type' for KVM configure."
            ;;
    esac

    echo -e "${colorGreen} Running: cd '$git_top' && ./Configure ${cfg_args[*]} ${colorReset}"
    ( cd "$git_top" && ./Configure "${cfg_args[@]}" )
    local rc=$?
    if [[ $rc -ne 0 ]]; then
        die "Configure failed (rc=$rc)"
    fi
    echo -e "${colorGreen} Done: ./Configure ${cfg_args[*]} (repo=$repo_type) ${colorReset}"
}


die () {
    [ "$#" -gt 0 ] && echo -e "${colorRed}  $0: $@  ${colorReset}" >&2
    cleanup
    exit 1
}


function cleanup() {
    trap - EXIT

    duration=$SECONDS
    echo "trap-cleanup(time=$(($duration / 60))m:$(($duration % 60))s)"

    # Backto the original current dir
    cd "$var_WorkDir"
}


# wget -O $HOME/bin/getoptions https://github.com/ko1nksm/getoptions/releases/latest/download/getoptions
trap "cleanup; exit 130" 1 2 3 15
if command -v getoptions &>/dev/null; then
    eval "$(getoptions parse_define) exit 1"
else
    parse_args "$@"
fi

main "$@"
